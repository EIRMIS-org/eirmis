# =============================================================================
# EIRMIS — Local Edge Function Secrets Template (supabase/.env.local.example)
# =============================================================================
# Copy this file to supabase/.env.local and fill in values for local testing:
#
#   cp supabase/.env.local.example supabase/.env.local   (macOS / Linux / Git Bash)
#   copy supabase\.env.local.example supabase\.env.local (Windows cmd / PowerShell)
#
# Serve Edge Functions locally with this file:
#   supabase functions serve --env-file ./supabase/.env.local
#
# supabase/.env.local is git-ignored and must NEVER be committed.
# This template (supabase/.env.local.example) contains NO real credentials.
#
# Note: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically by the Supabase Edge Runtime and should not be set here.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Transactional Email Delivery (Resend)
#    Used by: reminders, waitlist, register-public, qr-bundle,
#             headcount-requests, submit-headcount-request, html-scan-callback
# -----------------------------------------------------------------------------

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address (or onboarding@resend.dev for Resend sandbox testing)
RESEND_FROM_EMAIL="EIRMIS <noreply@eirmis.local>"


# -----------------------------------------------------------------------------
# 2. Application Base URL
#    Used by: reminders, qr-bundle (for links back to the guest portal)
# -----------------------------------------------------------------------------

APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# 3. QR Code HMAC-SHA256 Signing
#    Used by: attendees, checkin, qr-bundle
# -----------------------------------------------------------------------------

# Generate a 32-byte hex secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=replace-with-random-32-byte-hex-secret


# -----------------------------------------------------------------------------
# 4. Invitation HTML Malware Scanner & Webhook Verification
#    Used by: invitation-html, html-scan-callback
# -----------------------------------------------------------------------------

# Shared HMAC-SHA256 secret used by html-scan-callback to verify x-scanner-signature
SCANNER_WEBHOOK_SECRET=replace-with-random-webhook-secret

# External malware scanner API key and endpoints (optional for local non-upload tests)
VIRUSTOTAL_API_KEY=
SCANNER_API_KEY=
SCANNER_SUBMIT_URL=
SCANNER_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/html-scan-callback


# -----------------------------------------------------------------------------
# 5. Storage Bucket Overrides (Optional)
# -----------------------------------------------------------------------------

STORAGE_BUCKET_DESIGNS=invitation-designs
