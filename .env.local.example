# =============================================================================
# EIRMIS — Local Development Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
#
#   cp .env.local.example .env.local   (macOS / Linux / Git Bash)
#   copy .env.local.example .env.local (Windows cmd)
#
# .env.local is git-ignored and must NEVER be committed.
# This file (.env.local.example) is committed and contains NO real credentials.
#
# ⚠️  VITE_ variables are compiled into the browser bundle — they are PUBLIC.
#     NEVER place API keys, service-role keys, or any secret here.
#     All secrets belong in Edge Function secrets (see the "Edge Function Secrets"
#     section below).
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — Client (public, safe to expose)
# -----------------------------------------------------------------------------

# For LOCAL development: run `supabase start` then `supabase status` to get
# these values. They will look like the defaults below.
# For REMOTE (staging/production): copy from your Supabase project dashboard →
# Settings → API.

# Local default:  http://127.0.0.1:54321
# Remote example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321

# The publishable anon key — RLS policies are what protect the data, not this key.
# Local default:  run `supabase status` and copy the "anon key" line.
# Remote:         Supabase dashboard → Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=<paste-local-anon-key-from-supabase-status>

# The URL this app is served from. Used for OAuth callback URLs and magic-link
# redirects configured in Supabase Auth.
# Local:  http://localhost:5173
# Remote: https://your-production-domain.com
VITE_SITE_URL=http://localhost:5173

# The name of the Supabase Storage bucket for invitation gallery images and HTML
# uploads. Must match the bucket you create in the Supabase dashboard / migration.
# Example: invitation-designs
VITE_STORAGE_BUCKET_DESIGNS=invitation-designs


# =============================================================================
# Edge Function Secrets — DO NOT put these in .env.local
# =============================================================================
# The variables below are NOT read by Vite and must NOT appear in .env.local.
# They are listed here for reference only.
#
# Set them using the Supabase CLI AFTER running `supabase link`:
#
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#   supabase secrets set VIRUSTOTAL_API_KEY=xxxxxxxxxxxxxxxx
#
# Verify they are set:
#   supabase secrets list
#
# The following are injected by the Supabase platform automatically and must
# NOT be set manually:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#
# Google OAuth client ID/secret and the Resend SMTP credentials are configured
# in the Supabase dashboard (Auth → Providers / Auth → SMTP Settings), not as
# environment variables here.
# =============================================================================
