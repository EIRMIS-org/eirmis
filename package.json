{
  "name": "eirmis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:seed": "node scripts/check-seed-pii.js",
    "contract:lint": "npx @redocly/cli lint contract/openapi.yaml --config contract/redocly.yaml",
    "contract:gen": "npx openapi-typescript contract/openapi.yaml -o contract/generated/schema.d.ts",
    "contract:check": "node scripts/contract-check.js",
    "contract:docs": "redocly build-docs contract/openapi.yaml --config contract/redocly.yaml -o contract/generated/docs/index.html",
    "contract:mock": "prism mock contract/openapi.yaml -p 4010 --cors",
    "contract:mock:dynamic": "prism mock contract/openapi.yaml -p 4010 --cors -d",
    "contract:test": "tsx scripts/test-prism-endpoints.ts",
    "contract:postman": "tsx scripts/generate-postman-collection.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.2",
    "@stoplight/prism-cli": "^5.16.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
