{
  "name": "eirmis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:seed": "node scripts/check-seed-pii.js",
    "contract:lint": "redocly lint contract/openapi.yaml --config contract/redocly.yaml",
    "contract:gen": "openapi-typescript contract/openapi.yaml -o contract/generated/schema.d.ts",
    "contract:check": "node scripts/contract-check.js",
    "contract:docs": "redocly build-docs contract/openapi.yaml --config contract/redocly.yaml -o contract/generated/docs/index.html",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}